{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@snpos/core": [
        "../../packages/core/src/index.ts"
      ],
      "@snpos/ui": [
        "../../packages/ui/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../../packages/core/src",
    "../../packages/ui/src"
  ]
}
