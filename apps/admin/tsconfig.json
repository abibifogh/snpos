{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // The booking sheet is generated by the same module the notify job uses,
    // so the download and the emailed copy can never drift. It is plain JS
    // with JSDoc types; nothing else in this app reaches outside its own tree.
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@snpos/core": [
        "../../packages/core/src/index.ts"
      ],
      "@snpos/ui": [
        "../../packages/ui/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../../packages/core/src",
    "../../packages/ui/src"
  ],
  "exclude": [
    "../../packages/core/src/__tests__"
  ]
}
