# Copy to .env and fill in. Never commit .env.

# --- Server-side (provisioning scripts and Appwrite Functions) --------------
# Region-specific — copy the endpoint shown in your Appwrite console, e.g.
#   https://fra.cloud.appwrite.io/v1   (Frankfurt)
#   https://nyc.cloud.appwrite.io/v1   (New York)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
DB_ID=snpos

# --- Initial restaurant defaults (used once by provision.mjs) --------------
RESTAURANT_NAME=My Restaurant
TIMEZONE=Africa/Accra
CURRENCY_CODE=GHS
CURRENCY_SYMBOL=GH₵
DEFAULT_VENUE_ID=main

# --- Client-side (baked into the app builds; safe to expose) ---------------
# These identify the project; they do not grant access. Required to run any of
# the apps. No API key is needed for the apps — only for the setup scripts.
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT=
VITE_DB_ID=snpos
