{
  "name": "snpos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Restaurant POS on Appwrite \u2014 QR ordering, kitchen display, shift control, accounting",
  "scripts": {
    "provision": "node scripts/provision.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "gen:manual": "node scripts/gen-manual-setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "npm run dev -w @snpos/admin",
    "dev:admin": "npm run dev -w @snpos/admin",
    "build:admin": "npm run build -w @snpos/admin",
    "typecheck": "npm run typecheck -w @snpos/admin"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-appwrite": "^14.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
